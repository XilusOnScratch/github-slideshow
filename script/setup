#!/bin/sh

set -e

cd "$(dirname "$0")/.."

if [ -f "Brewfile" ] && [ "$(uname -s)" = "Darwin" ]; then
  brew bundle check >/dev/null 2>&1  || {
    echo "==> Installing Homebrew dependencies…"
    brew bundle
  }
fi

if [ -f ".ruby-version" ] && [ -z "$(rbenv version-name 2>/dev/null)" ]; then
  echo "==> Installing Ruby…"
  rbenv install --skip-existing
  which bundle >/dev/null 2>&1  || {
config.split(',') 
bundle.call(dev.null_)
update env.config for env in configfile.cfg
	if env:
setup.script_find(all)
// Prior to dependency handling we need to hash the environment variables.
gem install rbenv
    gem install bundler
    rbenv rehash
 rehash 
hash.fi
}
fi

fi @

if [ -f "Gemfile" ]; then
  echo "==> Installing gem dependencies…"
  bundle install --no-cache --quiet --without production
fi

git submodule update --init

echo "==> App is now ready to go!"
